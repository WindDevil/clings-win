#!/usr/bin/env python3
"""clings: a small, dependency-free runner for the clings C exercises.

The runner intentionally uses only the Python standard library.  It compiles
one exercise at a time with the system C compiler, runs it, and records
completed exercises in .clings/progress.json.
"""

from __future__ import annotations

import argparse
import json
import os
import platform
import shlex
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parent
EXERCISES_DIR = ROOT / "exercises"
SOLUTIONS_DIR = ROOT / "solutions"
TEMPLATES_DIR = ROOT / "templates"
BUILD_DIR = ROOT / "build" / "clings"
PROGRESS_FILE = ROOT / ".clings" / "progress.json"

DEFAULT_CFLAGS = [
    "-std=c17",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Werror",
    "-Wshadow",
    "-Wstrict-prototypes",
    "-Wpointer-arith",
    "-Wformat=2",
    "-Wundef",
    "-g",
    "-O0",
    "-D_POSIX_C_SOURCE=200809L",
    "-D_DEFAULT_SOURCE",
]
DEFAULT_LDLIBS = ["-lm", "-pthread"]
# True on Windows, and on a Linux host running the Wine regression loop
# (CLINGS_TARGET=windows) against the mingw-w64 cross compiler.
WINDOWS_TARGET = os.name == "nt" or os.environ.get("CLINGS_TARGET") == "windows"
if WINDOWS_TARGET:
    # Link one self-contained .exe per exercise.  Without this, programs
    # that use pthreads need libwinpthread-1.dll next to them, which is
    # the classic first blocker for Windows users.
    DEFAULT_LDLIBS.append("-static")
if sys.platform.startswith("linux") and not WINDOWS_TARGET:
    DEFAULT_LDLIBS.append("-ldl")


@dataclass(frozen=True)
class Exercise:
    topic: str
    slug: str
    path: Path
    title: str
    objective: str
    reference: str
    hint: str
    is_project: bool = False

    @property
    def ident(self) -> str:
        return f"{self.topic}/{self.slug}"

    @property
    def sources(self) -> tuple[Path, ...]:
        if self.is_project:
            return tuple(sorted(self.path.parent.glob("*.c")))
        return (self.path,)

    @property
    def solution_root(self) -> Path:
        if self.is_project:
            return SOLUTIONS_DIR / self.topic / self.slug
        return SOLUTIONS_DIR / self.topic / f"{self.slug}.c"

    @property
    def template_root(self) -> Path:
        if self.is_project:
            return TEMPLATES_DIR / self.topic / self.slug
        return TEMPLATES_DIR / self.topic / f"{self.slug}.c"

    @property
    def solution(self) -> Path:
        if self.is_project:
            return self.solution_root / "main.c"
        return self.solution_root

    @property
    def template(self) -> Path:
        if self.is_project:
            return self.template_root / "main.c"
        return self.template_root

    @property
    def solution_sources(self) -> tuple[Path, ...]:
        if self.is_project:
            return tuple(sorted(self.solution_root.glob("*.c")))
        return (self.solution_root,)

    def mtime_ns(self) -> int | None:
        files = list(self.sources)
        if self.is_project:
            files.extend(self.path.parent.glob("*.h"))
        newest: int | None = None
        for path in files:
            try:
                value = path.stat().st_mtime_ns
            except FileNotFoundError:
                continue
            newest = value if newest is None else max(newest, value)
        return newest


# Colour is decoration: every message says the same thing with the escapes
# stripped, so a console that cannot render ANSI gets plain text instead.
#
# A Windows console needs *two* output-mode bits before it interprets
# "\033[36m": ENABLE_VIRTUAL_TERMINAL_PROCESSING and ENABLE_PROCESSED_OUTPUT.
# With only the first one set conhost stores the escape in the screen buffer as
# ordinary characters, which is what turns "运行" into "?[36m运行?[0m" in cmd and
# in Windows PowerShell.  Measured on Windows 10 by writing an escape into a
# console and reading the buffer back: mode 0x4 and 0x6 stay literal, 0x5 and
# 0x7 render the colour.
#
# The mode belongs to the console screen buffer, not to this process: it is
# shared with everything else attached to that window and it outlives clings,
# so switching the bits on is a change the learner's shell inherits.
STD_OUTPUT_HANDLE = -11
ENABLE_PROCESSED_OUTPUT = 0x0001
ENABLE_VIRTUAL_TERMINAL_PROCESSING = 0x0004
ANSI_CONSOLE_MODE = ENABLE_PROCESSED_OUTPUT | ENABLE_VIRTUAL_TERMINAL_PROCESSING
# The answer cannot change while the process runs, so it is worth one probe.
_ansi_console: bool | None = None


def enable_ansi_console() -> bool:
    """Ask the console behind stdout to render ANSI escapes.

    False means it will not, and colour has to go.  On Windows the console
    needs both output-mode bits above before it interprets an escape, and
    SetConsoleMode refuses a handle that is not a console (a pipe or a file) as
    well as consoles older than Windows 10.  A GetConsoleMode that fails means
    the handle is not a Windows console at all - redirected output, a
    character device such as NUL, or a pipe-backed pseudo terminal - so there
    is no conhost to convince.  (A ConPTY-backed mintty succeeds here with VT
    already on; a Git Bash pty is not even a tty, so color_off_reason has
    already decided before this probe is reached.)
    """
    global _ansi_console
    if _ansi_console is not None:
        return _ansi_console
    if os.name != "nt":
        _ansi_console = True
        return _ansi_console
    try:
        import ctypes

        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
        kernel32.GetStdHandle.argtypes = [ctypes.c_uint32]
        kernel32.GetStdHandle.restype = ctypes.c_void_p
        kernel32.GetConsoleMode.argtypes = [
            ctypes.c_void_p,
            ctypes.POINTER(ctypes.c_uint32),
        ]
        kernel32.SetConsoleMode.argtypes = [ctypes.c_void_p, ctypes.c_uint32]
        mode = ctypes.c_uint32()
        handle = kernel32.GetStdHandle(STD_OUTPUT_HANDLE)
        if not kernel32.GetConsoleMode(handle, ctypes.byref(mode)):
            _ansi_console = True
        elif (mode.value & ANSI_CONSOLE_MODE) == ANSI_CONSOLE_MODE:
            _ansi_console = True
        else:
            wanted = mode.value | ANSI_CONSOLE_MODE
            _ansi_console = bool(kernel32.SetConsoleMode(handle, wanted))
    except (AttributeError, ImportError, OSError, ValueError):
        # A Python whose _ctypes cannot load raises ImportError here; colour is
        # decoration, so it costs plain text and not a traceback.
        _ansi_console = False
    return _ansi_console


def color_off_reason() -> str:
    """Why the output is plain text, or "" when it carries colour.

    CLINGS_COLOR decides first, because it is what a learner reaches for when
    the guess is wrong and what the CI job pins down; then the NO_COLOR
    convention (https://no-color.org/); then auto detection.
    """
    choice = os.environ.get("CLINGS_COLOR", "auto").strip().lower()
    if choice == "never":
        return "CLINGS_COLOR=never"
    if choice != "always":
        if os.environ.get("NO_COLOR"):
            return "NO_COLOR 已设置"
        # A missing stdout (pythonw, or a shell that closed fd 1) is not a
        # terminal either, and asking it would raise instead of answering.
        try:
            interactive = sys.stdout is not None and sys.stdout.isatty()
        except ValueError:
            interactive = False
        if not interactive:
            return "输出不是终端"
        if not enable_ansi_console():
            return "控制台不支持 ANSI"
        return ""
    # Forced on.  A Windows console still has to be asked to render the
    # escapes, or CLINGS_COLOR=always would print them as literal text in the
    # very consoles this whole dance exists to keep readable.
    enable_ansi_console()
    return ""


def color(text: str, code: str) -> str:
    if color_off_reason():
        return text
    return f"\033[{code}m{text}\033[0m"


def green(text: str) -> str:
    return color(text, "32")


def red(text: str) -> str:
    return color(text, "31")


def yellow(text: str) -> str:
    return color(text, "33")


def cyan(text: str) -> str:
    return color(text, "36")


def read_metadata(path: Path) -> dict[str, str]:
    metadata: dict[str, str] = {}
    with path.open("r", encoding="utf-8") as handle:
        for line in handle:
            if not line.startswith(" * "):
                if line.strip() == "*/":
                    break
                continue
            payload = line[3:].strip()
            if ":" not in payload:
                continue
            key, value = payload.split(":", 1)
            metadata[key.strip().lower()] = value.strip()
    return metadata


def discover() -> list[Exercise]:
    exercises: list[Exercise] = []
    if not EXERCISES_DIR.exists():
        return exercises
    for path in sorted(EXERCISES_DIR.glob("*/*.c")):
        meta = read_metadata(path)
        exercises.append(
            Exercise(
                topic=path.parent.name,
                slug=path.stem,
                path=path,
                title=meta.get("title", path.stem.replace("_", " ")),
                objective=meta.get("objective", ""),
                reference=meta.get("reference", ""),
                hint=meta.get("hint", "暂无提示。"),
            )
        )
    for path in sorted(EXERCISES_DIR.glob("*/*/main.c")):
        meta = read_metadata(path)
        exercises.append(
            Exercise(
                topic=path.parent.parent.name,
                slug=path.parent.name,
                path=path,
                title=meta.get("title", path.parent.name.replace("_", " ")),
                objective=meta.get("objective", ""),
                reference=meta.get("reference", ""),
                hint=meta.get("hint", "暂无提示。"),
                is_project=True,
            )
        )
    topic_order = {
        "00_basics": 0,
        "01_preprocessor": 1,
        "03_types_variables": 2,
        "02_macros": 3,
        "04_operators": 4,
        "05_control_flow": 5,
        "06_functions": 6,
        "07_pointers": 7,
        "10_aggregates": 8,
        "08_arrays_strings": 9,
        "09_dynamic_memory": 10,
        "11_data_representation": 11,
        "12_standard_library": 12,
        "13_character_io": 13,
        "14_file_io": 14,
        "15_ub_safety": 15,
        "16_data_structures": 16,
        "17_translation_units": 17,
        "18_advanced_c": 18,
        "19_modern_c_library": 19,
    }
    exercises.sort(
        key=lambda exercise: (
            topic_order.get(exercise.topic, len(topic_order)),
            exercise.slug,
        )
    )
    return exercises


def load_progress() -> set[str]:
    if not PROGRESS_FILE.exists():
        return set()
    try:
        data = json.loads(PROGRESS_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return set()
    return set(data.get("completed", []))


def save_progress(completed: set[str]) -> None:
    PROGRESS_FILE.parent.mkdir(parents=True, exist_ok=True)
    PROGRESS_FILE.write_text(
        json.dumps({"completed": sorted(completed)}, indent=2) + "\n",
        encoding="utf-8",
    )


def compiler() -> str:
    """The C compiler to use, overridable through the CC environment variable."""
    default = "gcc" if WINDOWS_TARGET else "cc"
    return os.environ.get("CC", default)


def exe_suffix() -> str:
    """``.exe`` on Windows and for the Wine regression loop."""
    return ".exe" if WINDOWS_TARGET else ""


def exec_prefix() -> list[str]:
    """Launcher placed in front of every built binary.

    Empty on Windows.  The Wine regression loop sets CLINGS_EXEC_PREFIX
    so PE binaries produced by the cross compiler can be executed.
    """
    return shlex.split(os.environ.get("CLINGS_EXEC_PREFIX", ""))


def launcher() -> str:
    """How the learner names this script on the command line.

    The two Windows shells agree on exactly one spelling.  cmd.exe reads
    a leading './' as a command named '.', and PowerShell does not look
    in the current directory at all, so './clings' and a bare 'clings'
    each fail in one of them while .\\.clings.cmd works in both.
    """
    return r".\clings.cmd" if WINDOWS_TARGET else "./clings"


def cflags() -> list[str]:
    extra = os.environ.get("CFLAGS", "")
    return DEFAULT_CFLAGS + shlex.split(extra)


def binary_path(exercise: Exercise, solution: bool = False) -> Path:
    suffix = "solution" if solution else "exercise"
    return BUILD_DIR / exercise.topic / f"{exercise.slug}.{suffix}{exe_suffix()}"


class ToolchainError(RuntimeError):
    """The C compiler this package compiles with is not there at all."""


def missing_compiler_message() -> str:
    return (
        red(f"没有找到 C 编译器: {compiler()}") + "\n"
        "  这个包自带的编译器在 runtime\\mingw\\bin（只有 -full.zip 才有）；\n"
        "  它不在的话，重新解压一份 full 包，或者自己装 MinGW-w64 并把 gcc 放进 PATH。\n"
        f"  看当前工具链: {launcher()} doctor\n"
        "  装好之后，把刚才那条命令再跑一遍。"
    )


def compile_sources(
    sources: tuple[Path, ...],
    output: Path,
    include_dirs: tuple[Path, ...] = (),
) -> subprocess.CompletedProcess[str]:
    output.parent.mkdir(parents=True, exist_ok=True)
    command = [
        compiler(),
        *cflags(),
        f"-I{ROOT / 'include'}",
    ]
    for directory in include_dirs:
        command.append(f"-I{directory}")
    command.extend(str(source) for source in sources)
    command.append(str(ROOT / "include" / "clings" / "test.c"))
    command.extend(["-o", str(output), *DEFAULT_LDLIBS])
    try:
        return subprocess.run(
            command,
            cwd=ROOT,
            text=True,
            errors="replace",
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
        )
    except OSError as error:
        raise ToolchainError(missing_compiler_message()) from error


def compile_source(source: Path, output: Path) -> subprocess.CompletedProcess[str]:
    return compile_sources((source,), output)


def run_binary(path: Path, timeout: float = 10.0) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [*exec_prefix(), str(path)],
        cwd=ROOT,
        text=True,
        errors="replace",
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=timeout,
        check=False,
    )


def resolve_exercise(needle: str | None) -> Exercise | None:
    exercises = discover()
    if not exercises:
        return None
    if needle is None:
        completed = load_progress()
        for exercise in exercises:
            if exercise.ident not in completed:
                return exercise
        return None

    exact = [exercise for exercise in exercises if exercise.ident == needle]
    if exact:
        return exact[0]

    matches = [
        exercise
        for exercise in exercises
        if exercise.ident.endswith(f"/{needle}")
        or exercise.slug == needle
        or needle in exercise.ident
    ]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        print(red(f"练习名有歧义: {needle}"))
        for exercise in matches:
            print(f"  {exercise.ident}")
    else:
        print(red(f"找不到这个练习: {needle}"))
    return None


def run_exercise(
    exercise: Exercise, verbose: bool = False
) -> tuple[bool, str, str]:
    """Compile and run one exercise.

    The third element names the stage that produced this result - "compile",
    "run" or "timeout" - so a caller reporting it to a learner can say which
    one failed without matching on the message text.
    """
    output = binary_path(exercise)
    include_dirs = (exercise.path.parent,) if exercise.is_project else ()
    build = compile_sources(exercise.sources, output, include_dirs)
    if build.returncode != 0:
        return False, "编译失败\n" + build.stdout, "compile"

    try:
        result = run_binary(output)
    except subprocess.TimeoutExpired:
        return False, "练习运行超过 10 秒，已中止", "timeout"

    if verbose or result.returncode != 0:
        return result.returncode == 0, result.stdout, "run"
    return result.returncode == 0, result.stdout, "run"


def run_solution(exercise: Exercise) -> tuple[bool, str]:
    if not exercise.solution_sources or not all(
        source.exists() for source in exercise.solution_sources
    ):
        return False, f"找不到参考答案: {exercise.solution_root}"
    output = binary_path(exercise, solution=True)
    include_dirs = (
        (exercise.solution_root,) if exercise.is_project else ()
    )
    build = compile_sources(exercise.solution_sources, output, include_dirs)
    if build.returncode != 0:
        return False, "参考答案编译失败\n" + build.stdout
    try:
        result = run_binary(output)
    except subprocess.TimeoutExpired:
        return False, "参考答案运行超过 10 秒，已中止"
    return result.returncode == 0, result.stdout


def print_exercise(exercise: Exercise, completed: set[str]) -> None:
    status = green("已完成") if exercise.ident in completed else yellow("待完成")
    print(f"[{status}] {cyan(exercise.ident)}  {exercise.title}")
    if exercise.objective:
        print(f"       {exercise.objective}")
    if exercise.reference:
        print(f"       reference: {exercise.reference}")


def exercise_files(exercise: Exercise) -> list[Path]:
    """Every file that belongs to an exercise, in the order to show them.

    For the five multi-file exercises this is the whole directory: the .c
    files that get compiled, and the headers they include, which are just as
    much the learner's to edit but never appear on a command line.
    """
    files = list(exercise.sources)
    if exercise.is_project:
        files.extend(sorted(exercise.path.parent.glob("*.h")))
    return files


def exercise_record(exercise: Exercise, completed: set[str]) -> dict[str, object]:
    """The machine-readable shape of one exercise.

    A consumer that only has this JSON must be able to render the exercise
    list on its own, so it carries the header metadata, whether the learner
    has passed it, the files that make it up, and which of them a build
    actually compiles.  Paths are relative to ROOT with forward slashes,
    which reads the same on a POSIX host and on Windows.
    """
    return {
        "ident": exercise.ident,
        "topic": exercise.topic,
        "slug": exercise.slug,
        "title": exercise.title,
        "objective": exercise.objective,
        "reference": exercise.reference,
        "hint": exercise.hint,
        "is_project": exercise.is_project,
        "completed": exercise.ident in completed,
        "files": [
            path.relative_to(ROOT).as_posix() for path in exercise_files(exercise)
        ],
        "sources": [
            source.relative_to(ROOT).as_posix() for source in exercise.sources
        ],
    }


def emit_json(payload: object) -> None:
    """Write one JSON document and flush it.

    ensure_ascii=False keeps the Chinese titles readable to a human reading
    the raw output; consumers decode UTF-8, which configure_output already
    guarantees for this process on Windows.
    """
    json.dump(payload, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")
    sys.stdout.flush()


def command_list(args: argparse.Namespace) -> int:
    exercises = discover()
    completed = load_progress()
    if not exercises:
        print(red("没有找到任何练习"))
        return 1

    if getattr(args, "json", False):
        topics: list[dict[str, object]] = []
        for exercise in exercises:
            if args.topic and exercise.topic != args.topic:
                continue
            if not topics or topics[-1]["name"] != exercise.topic:
                topics.append({"name": exercise.topic, "exercises": []})
            listed = topics[-1]["exercises"]
            if isinstance(listed, list):
                listed.append(exercise_record(exercise, completed))
        emit_json(
            {
                "root": str(ROOT),
                "launcher": launcher(),
                "total": len(exercises),
                "completed_count": sum(
                    1 for exercise in exercises if exercise.ident in completed
                ),
                "topics": topics,
            }
        )
        return 0

    current_topic = None
    for exercise in exercises:
        if args.topic and exercise.topic != args.topic:
            continue
        if exercise.topic != current_topic:
            current_topic = exercise.topic
            print(f"\n{cyan(current_topic)}")
        print_exercise(exercise, completed)
    completed_count = sum(1 for exercise in exercises if exercise.ident in completed)
    print(f"\n已完成 {completed_count}/{len(exercises)}")
    return 0


def command_next(args: argparse.Namespace) -> int:
    exercise = resolve_exercise(args.exercise)
    if exercise is None:
        if args.exercise:
            return 1
        print(green(f"所有练习都完成了。可以运行 `{launcher()} verify` 做一次全量校验。"))
        return 0
    print_exercise(exercise, load_progress())
    return 0


def command_run(args: argparse.Namespace) -> int:
    exercises = discover()
    if not exercises:
        print(red("没有找到任何练习"))
        return 1

    if args.all:
        targets = exercises
    else:
        exercise = resolve_exercise(args.exercise)
        if exercise is None:
            if args.exercise:
                return 1
            print(green(f"所有练习都完成了。可以运行 `{launcher()} verify` 做一次全量校验。"))
            return 0
        targets = [exercise]

    json_mode = bool(getattr(args, "json", False))
    completed = load_progress()
    # Only a single exercise is progress the learner made.  `run --all` is a
    # maintainer's or a CI job's sweep over every exercise, and on a host where
    # a Windows-only exercise happens to pass it used to record that as the
    # learner's own work - the progress bar then claimed exercises they never
    # opened.
    record_progress = not args.all
    failures = 0
    results: list[dict[str, object]] = []
    for exercise in targets:
        if not json_mode:
            print(f"\n{cyan('运行')} {exercise.ident} - {exercise.title}")
        passed, output, stage = run_exercise(exercise, verbose=args.verbose)
        results.append(
            {
                "ident": exercise.ident,
                "title": exercise.title,
                "passed": passed,
                "stage": stage,
                "output": output,
            }
        )
        if passed:
            if record_progress:
                completed.add(exercise.ident)
                save_progress(completed)
            if not json_mode:
                print(green("  通过"))
            if args.verbose and output and not json_mode:
                print(output, end="" if output.endswith("\n") else "\n")
            continue

        failures += 1
        if not json_mode:
            print(red("  未通过"))
            if output:
                print(output, end="" if output.endswith("\n") else "\n")
            next_steps(exercise)
        if not args.continue_on_error:
            break

    if json_mode:
        emit_json(
            {
                "results": results,
                "failures": failures,
                "completed_count": sum(
                    1 for exercise in exercises if exercise.ident in completed
                ),
            }
        )
        return 1 if failures else 0
    if failures:
        print(red(f"\n{failures} 个练习未通过"))
        return 1
    print(green("\n选中的练习全部通过"))
    return 0


def next_steps(exercise: Exercise) -> None:
    """Name the file and the two commands that move a stuck learner forward.

    The blank in the exercise is the teaching device and the compiler output
    is what it teaches with.  This adds the sentence neither of them can: that
    the failure is the starting point, and which file to open.

    A multi-file exercise has one file with the blank in it and the rest
    complete, so naming the entry point sends the learner to a file that has
    nothing to do; the file to open is the one that carries the TODO.  Every
    file counts as a candidate, headers included, because that is where the
    blank is in some of them.
    """
    files = list(exercise.sources)
    if exercise.is_project:
        files.extend(sorted(exercise.path.parent.glob("*.h")))
    todo_files = []
    for path in files:
        try:
            if "TODO" in path.read_text(encoding="utf-8"):
                todo_files.append(path)
        except OSError:
            continue
    targets = todo_files or files
    print()
    print("  这道题一开始就是通不过的：文件里留了空（注释里的 TODO），报错就是它给的线索。")
    for path in targets:
        print(f"  要改的文件:  {path.relative_to(ROOT)}")
    print(f"  看提示:      {launcher()} hint {exercise.ident}")
    print(f"  改完重跑:    {launcher()} run {exercise.ident}")


def command_hint(args: argparse.Namespace) -> int:
    exercise = resolve_exercise(args.exercise)
    if exercise is None:
        return 1
    print(f"{cyan(exercise.ident)} - {exercise.title}")
    print(f"学习目标: {exercise.objective}")
    if exercise.reference:
        print(f"参考资料: {exercise.reference}")
    print(f"提示: {exercise.hint}")
    return 0


def command_solution(args: argparse.Namespace) -> int:
    exercise = resolve_exercise(args.exercise)
    if exercise is None:
        return 1
    if not exercise.solution_root.exists():
        print(red(f"找不到参考答案: {exercise.solution_root}"))
        return 1
    if args.apply:
        if exercise.is_project:
            shutil.rmtree(exercise.path.parent, ignore_errors=True)
            shutil.copytree(exercise.solution_root, exercise.path.parent)
            print(green(f"已把参考答案写到 {exercise.path.parent}"))
        else:
            shutil.copyfile(exercise.solution, exercise.path)
            print(green(f"已把参考答案写到 {exercise.path}"))
        return 0
    if exercise.is_project:
        for source in exercise.solution_sources:
            print(f"// ===== {source.name} =====")
            print(source.read_text(encoding="utf-8"), end="")
    else:
        print(exercise.solution.read_text(encoding="utf-8"), end="")
    return 0


def command_reset(args: argparse.Namespace) -> int:
    exercise = resolve_exercise(args.exercise)
    if exercise is None:
        return 1
    if not exercise.template_root.exists():
        print(red(f"找不到初始模板: {exercise.template_root}"))
        return 1
    if exercise.is_project:
        shutil.rmtree(exercise.path.parent, ignore_errors=True)
        shutil.copytree(exercise.template_root, exercise.path.parent)
    else:
        shutil.copyfile(exercise.template, exercise.path)
    completed = load_progress()
    completed.discard(exercise.ident)
    save_progress(completed)
    print(green(f"已重置 {exercise.ident}"))
    return 0


def command_verify(args: argparse.Namespace) -> int:
    exercises = discover()
    if not exercises:
        print(red("没有找到任何练习"))
        return 1

    failures = 0
    for exercise in exercises:
        passed, output = run_solution(exercise)
        if passed:
            print(f"{green('ok')}   {exercise.ident}")
            continue
        failures += 1
        print(f"{red('FAIL')} {exercise.ident}")
        if args.verbose:
            print(output, end="" if output.endswith("\n") else "\n")

    if failures:
        print(red(f"\n{failures} 个参考答案未通过"))
        return 1
    print(green(f"\n{len(exercises)} 个参考答案全部通过"))
    return 0


def command_selftest(args: argparse.Namespace) -> int:
    """Check that exercises start unsolved and solutions pass."""
    exercises = discover()
    failures = 0
    for exercise in exercises:
        solved, solution_output = run_solution(exercise)
        if not solved:
            failures += 1
            print(f"{red('FAIL')} 参考答案 {exercise.ident}")
            print(solution_output, end="" if solution_output.endswith("\n") else "\n")
            continue

        # A broken exercise may fail to compile or fail at runtime.  Both are
        # valid starting states; it must not pass before the learner edits it.
        passed, _, _ = run_exercise(exercise)
        if passed:
            failures += 1
            print(f"{red('FAIL')} 练习 {exercise.ident} 初始状态就通过了")
            continue

        print(f"{green('ok')}   {exercise.ident}")

    if failures:
        print(red(f"\n{failures} 项自检未通过"))
        return 1
    print(green(f"\n{len(exercises)} 个练习的初始状态都符合预期"))
    return 0


def command_doctor(args: argparse.Namespace) -> int:
    if getattr(args, "json", False):
        import inspect

        # A missing compiler is a state the caller has to be able to report -
        # the slim package expects the learner to have installed one - so it
        # must not come back as a traceback.
        try:
            probe = subprocess.run(
                [compiler(), "--version"],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                check=False,
            )
            version = probe.stdout.splitlines()[0] if probe.stdout else ""
        except OSError:
            version = ""
        emit_json(
            {
                "python": platform.python_version(),
                "platform": platform.platform(),
                "root": str(ROOT),
                "launcher": launcher(),
                "compiler": compiler(),
                "compiler_found": bool(version),
                "compiler_version": version,
                # A caller that shows diagnostics while the learner types has
                # to compile the way `run` does, or it reports a different set
                # of errors than the exercise itself does.  These are the only
                # flags and search paths that decide that.
                "cflags": cflags(),
                "ldlibs": DEFAULT_LDLIBS,
                "include_dirs": [
                    (ROOT / "include").relative_to(ROOT).as_posix(),
                    ".",
                ],
                "test_source": "include/clings/test.c",
                # Read off run_binary rather than repeated here, so a caller
                # that puts its own deadline around a run cannot drift away
                # from the deadline the runner itself applies.
                "timeout_seconds": inspect.signature(run_binary)
                .parameters["timeout"]
                .default,
            }
        )
        return 0
    print(f"Python:   {platform.python_version()}")
    print(f"系统:     {platform.platform()}")
    print(f"项目目录: {ROOT}")
    print(f"编译器:   {compiler()}")
    print(f"编译参数: {' '.join(cflags())}")
    # The first thing to check when colour comes out as escape codes:
    # which console is this, and did clings decide it can show them?
    reason = color_off_reason()
    print(f"颜色:     {'开启' if not reason else '关闭（' + reason + '）'}")
    result = subprocess.run(
        [compiler(), "--version"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    print(result.stdout.splitlines()[0] if result.stdout else "没有找到编译器")
    return 0


def command_watch(args: argparse.Namespace) -> int:
    exercise = resolve_exercise(args.exercise)
    if exercise is None:
        return 1
    print(f"正在监视 {exercise.ident}；按 Ctrl-C 退出")
    last_mtime = None
    while True:
        mtime = exercise.mtime_ns()
        if mtime != last_mtime:
            last_mtime = mtime
            print(f"\n{cyan('running')} {exercise.ident}")
            passed, output, _ = run_exercise(exercise, verbose=True)
            print(green("passed") if passed else red("failed"))
            if output:
                print(output, end="" if output.endswith("\n") else "\n")
        time.sleep(0.5)


def command_clean(args: argparse.Namespace) -> int:
    if BUILD_DIR.exists():
        shutil.rmtree(BUILD_DIR)
        print(green(f"已删除 {BUILD_DIR}"))
    else:
        print("没有需要清理的编译产物")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="clings",
        description="编译并运行 clings 的 C 语言练习。",
    )
    subparsers = parser.add_subparsers(dest="command")

    list_parser = subparsers.add_parser("list", help="列出全部练习")
    list_parser.add_argument("--topic", help="only show one topic")
    list_parser.add_argument("--json", action="store_true", help="以 JSON 输出")
    list_parser.set_defaults(func=command_list)

    next_parser = subparsers.add_parser("next", help="显示下一个练习")
    next_parser.add_argument("exercise", nargs="?")
    next_parser.set_defaults(func=command_next)

    run_parser = subparsers.add_parser("run", help="编译并运行一个练习")
    run_parser.add_argument("exercise", nargs="?")
    run_parser.add_argument("--all", action="store_true", help="运行全部练习")
    run_parser.add_argument(
        "--continue",
        dest="continue_on_error",
        action="store_true",
        help="失败后继续往下跑",
    )
    run_parser.add_argument("--verbose", action="store_true")
    run_parser.add_argument("--json", action="store_true", help="以 JSON 输出")
    run_parser.set_defaults(func=command_run)

    hint_parser = subparsers.add_parser("hint", help="查看提示")
    hint_parser.add_argument("exercise")
    hint_parser.set_defaults(func=command_hint)

    solution_parser = subparsers.add_parser("solution", help="查看或应用参考答案")
    solution_parser.add_argument("exercise")
    solution_parser.add_argument(
        "--apply",
        action="store_true",
        help="把参考答案写到练习文件上",
    )
    solution_parser.set_defaults(func=command_solution)

    reset_parser = subparsers.add_parser("reset", help="恢复初始练习")
    reset_parser.add_argument("exercise")
    reset_parser.set_defaults(func=command_reset)

    verify_parser = subparsers.add_parser("verify", help="校验全部参考答案")
    verify_parser.add_argument("--verbose", action="store_true")
    verify_parser.set_defaults(func=command_verify)

    selftest_parser = subparsers.add_parser(
        "selftest", help="检查练习初始失败、参考答案通过"
    )
    selftest_parser.set_defaults(func=command_selftest)

    doctor_parser = subparsers.add_parser("doctor", help="显示工具链信息")
    doctor_parser.add_argument("--json", action="store_true", help="以 JSON 输出")
    doctor_parser.set_defaults(func=command_doctor)

    watch_parser = subparsers.add_parser("watch", help="文件变化后自动重跑")
    watch_parser.add_argument("exercise", nargs="?")
    watch_parser.set_defaults(func=command_watch)

    clean_parser = subparsers.add_parser("clean", help="删除编译产物")
    clean_parser.set_defaults(func=command_clean)

    return parser


def configure_output() -> None:
    """Keep Chinese output from crashing a Windows console.

    Python takes the console code page (cp936, cp1252, ...) for stdout
    and raises UnicodeEncodeError on text it cannot represent.
    clings.cmd switches the console to UTF-8; this makes the streams
    agree with it, and degrades to '?' instead of a traceback when the
    CLI is started some other way.
    """
    if os.name != "nt":
        return
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError):
            pass


def main(argv: list[str] | None = None) -> int:
    configure_output()
    parser = build_parser()
    args = parser.parse_args(argv)
    if not hasattr(args, "func"):
        args = parser.parse_args(["list"])
    try:
        return int(args.func(args))
    except ToolchainError as error:
        print(error)
        return 2
    except KeyboardInterrupt:
        print("\n已中断")
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
